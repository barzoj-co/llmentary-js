{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", ":semanticCommits"],
  "timezone": "Europe/Amsterdam",
  "schedule": ["before 7am on monday"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "platformAutomerge": true,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "schedule": ["at any time"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 7am on monday"],
    "automerge": true
  },
  "ignorePaths": ["packages/**"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "github actions",
      "automerge": true
    },
    {
      "matchDepTypes": ["dependencies"],
      "rangeStrategy": "update-lockfile"
    },
    {
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@llm-test-lab/**"],
      "enabled": false
    },
    {
      "matchDepNames": ["node"],
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "matchPackageNames": ["vitest", "@vitest/**"],
      "groupName": "vitest"
    },
    {
      "matchPackageNames": ["typescript", "@types/node"],
      "automerge": false
    },
    {
      "matchPackageNames": ["barzoj-co/llm-test-lab"],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pin CLI tool versions annotated with # renovate: in GitHub workflows",
      "managerFilePatterns": ["/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[-a-z]+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\s+[A-Za-z0-9_]+_VERSION:\\s*[\"']?(?<currentValue>[^\"'\\s]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Pin Jest used via npx in package.json scripts",
      "managerFilePatterns": ["/(^|/)package\\.json$/"],
      "matchStrings": ["npx --yes (?<depName>jest)@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Pin bundled proxy version from barzoj-co/llm-test-lab releases (Option B)",
      "managerFilePatterns": ["/(^|/)PROXY_VERSION$/"],
      "matchStrings": ["(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?)\n?"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "barzoj-co/llm-test-lab"
    }
  ]
}
