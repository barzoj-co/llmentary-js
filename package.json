{
  "name": "llmentary",
  "version": "0.2.1",
  "description": "TypeScript (Vitest/Jest) client for llmentary: deterministic trace-based integration tests for LLM apps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barzoj-co/llmentary-js.git"
  },
  "bugs": {
    "url": "https://github.com/barzoj-co/llmentary-js/issues"
  },
  "homepage": "https://github.com/barzoj-co/llmentary-js#readme",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "LICENSE",
    "licenses"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./vitest": {
      "import": {
        "types": "./dist/esm/vitest.d.ts",
        "default": "./dist/esm/vitest.js"
      },
      "require": {
        "types": "./dist/cjs/vitest.d.ts",
        "default": "./dist/cjs/vitest.js"
      }
    },
    "./jest": {
      "import": {
        "types": "./dist/esm/jest.d.ts",
        "default": "./dist/esm/jest.js"
      },
      "require": {
        "types": "./dist/cjs/jest.d.ts",
        "default": "./dist/cjs/jest.js"
      }
    },
    "./jest/globalSetup": {
      "import": {
        "types": "./dist/esm/jest/globalSetup.d.ts",
        "default": "./dist/esm/jest/globalSetup.js"
      },
      "require": {
        "types": "./dist/cjs/jest/globalSetup.d.ts",
        "default": "./dist/cjs/jest/globalSetup.js"
      }
    },
    "./jest/globalTeardown": {
      "import": {
        "types": "./dist/esm/jest/globalTeardown.d.ts",
        "default": "./dist/esm/jest/globalTeardown.js"
      },
      "require": {
        "types": "./dist/cjs/jest/globalTeardown.d.ts",
        "default": "./dist/cjs/jest/globalTeardown.js"
      }
    },
    "./jest/setup": {
      "import": {
        "types": "./dist/esm/jest/setup.d.ts",
        "default": "./dist/esm/jest/setup.js"
      },
      "require": {
        "types": "./dist/cjs/jest/setup.d.ts",
        "default": "./dist/cjs/jest/setup.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "typesVersions": {
    "*": {
      "vitest": [
        "./dist/cjs/vitest.d.ts"
      ],
      "jest": [
        "./dist/cjs/jest.d.ts"
      ],
      "jest/globalSetup": [
        "./dist/cjs/jest/globalSetup.d.ts"
      ],
      "jest/globalTeardown": [
        "./dist/cjs/jest/globalTeardown.d.ts"
      ],
      "jest/setup": [
        "./dist/cjs/jest/setup.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.cjs",
    "clean": "rm -rf dist coverage .llmentary",
    "lint": "eslint src tests --ignore-pattern 'tests/jest/*.cjs'",
    "test": "npm run test:unit && npm run test:proxy && npm run test:jest",
    "test:unit": "vitest run tests/assertions.test.ts tests/binary.test.ts tests/control.test.ts tests/isolation.test.ts tests/normalize.test.ts tests/path-filters-mentions.test.ts tests/session.test.ts tests/process.test.ts tests/jest-state.test.ts tests/readme-api.test.ts tests/spec-validation.test.ts tests/wait.test.ts",
    "test:coverage": "vitest run tests/assertions.test.ts tests/binary.test.ts tests/control.test.ts tests/isolation.test.ts tests/normalize.test.ts tests/path-filters-mentions.test.ts tests/session.test.ts tests/process.test.ts tests/jest-state.test.ts tests/proxy-real-binary.test.ts tests/proxy-upstream-join.test.ts tests/readme-api.test.ts tests/spec-validation.test.ts tests/wait.test.ts --coverage",
    "test:vitest": "vitest run",
    "test:proxy": "vitest run tests/proxy-real-binary.test.ts tests/proxy-upstream-join.test.ts",
    "test:jest": "npm run test:jest:unit && npm run test:jest:proxy",
    "test:jest:unit": "npm run build && npx --yes jest@30.5.2 --config jest.config.cjs tests/jest/cjs-export.test.cjs",
    "test:jest:proxy": "npm run build && npx --yes jest@30.5.2 --config jest.config.cjs tests/jest/proxy-real-binary.test.cjs && vitest run --config vitest.concurrent.config.ts",
    "attw": "attw --pack .",
    "test:pack": "node scripts/check-pack-consumers.mjs",
    "test:e2e:openai": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "peerDependencies": {
    "vitest": ">=1"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@llmentary/darwin-arm64": "0.3.0",
    "@llmentary/darwin-x64": "0.3.0",
    "@llmentary/linux-arm64": "0.3.0",
    "@llmentary/linux-x64": "0.3.0",
    "@llmentary/win32-x64": "0.3.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.5",
    "openai": "^7.38.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "tinypool": "2.1.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
